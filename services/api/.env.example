PORT=4000
NODE_ENV=development
# Local-only identity shortcut. Never enable in a deployed environment.
DEV_AUTH_BYPASS=true
# Set the following when validating real Entra External ID access tokens.
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URI=
# Azure SQL connection string; migrations are in db/migrations.
AZURE_SQL_CONNECTION_STRING=
# When configured, credentials are stored in this Key Vault instead of process memory.
AZURE_KEY_VAULT_URL=
# Kalshi production API base. Tests inject a fake transport.
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
